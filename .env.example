# Podcast Index（可选；只使用 Apple Podcasts 时不需要）
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# 安全资源上限。下面都是默认值，可按机器和业务需要调整。
AUDIOSPIDER_MAX_BATCH_SIZE=10000
AUDIOSPIDER_MAX_WORKERS=32
AUDIOSPIDER_MAX_DOWNLOAD_BYTES=4294967296
AUDIOSPIDER_MIN_DISK_FREE_BYTES=21474836480
AUDIOSPIDER_DOWNLOAD_LEASE_SECONDS=7200
AUDIOSPIDER_MAX_RSS_SIZE=20971520
AUDIOSPIDER_MAX_BACKGROUND_ASSET_BYTES=20971520
AUDIOSPIDER_MAX_BACKGROUND_TOTAL_BYTES=52428800
AUDIOSPIDER_MAX_BACKGROUND_ASSETS=12
