# Podcast Index（可选；只使用 Apple Podcasts 时不需要）
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# 安全资源上限。下面都是默认值，可按机器和业务需要调整。
AUDIOSPIDER_MAX_BATCH_SIZE=10000
AUDIOSPIDER_MAX_WORKERS=32
AUDIOSPIDER_MAX_DOWNLOAD_BYTES=4294967296
AUDIOSPIDER_MIN_DISK_FREE_BYTES=21474836480
AUDIOSPIDER_DOWNLOAD_LEASE_SECONDS=7200
AUDIOSPIDER_MAX_RSS_SIZE=20971520
AUDIOSPIDER_MAX_BACKGROUND_ASSET_BYTES=20971520
AUDIOSPIDER_MAX_BACKGROUND_TOTAL_BYTES=52428800
AUDIOSPIDER_MAX_BACKGROUND_ASSETS=12
AUDIOSPIDER_BACKGROUND_ASSET_TIMEOUT=75

# YouTube 外部提取器使用可终止子进程，防止网络长时间无响应。
AUDIOSPIDER_YOUTUBE_MAX_ITEMS=100
AUDIOSPIDER_YOUTUBE_INSPECT_TIMEOUT=120
AUDIOSPIDER_YOUTUBE_DOWNLOAD_TIMEOUT=14400
AUDIOSPIDER_BILIBILI_CONTENT_LANGUAGE=zh

# B站正式 collect.py 的可选批次边界。关键词使用英文逗号分隔；
# MAX_NEW_RECORDS=0 表示不限，正数按数据库真实新增量停止（重复任务不占配额）。
# AUDIOSPIDER_BILIBILI_KEYWORDS=人物访谈 长视频,深度访谈 完整版,人物专访 完整版,对谈 完整版,圆桌访谈,播客 访谈 视频
# AUDIOSPIDER_BILIBILI_REQUIRED_TITLE_TERMS=访谈,专访,对谈,对话,圆桌,会谈,播客
# AUDIOSPIDER_BILIBILI_EXCLUDED_TITLE_TERMS=俄语,英语,英文,日语,韩语,法语,德语,西班牙语
# AUDIOSPIDER_BILIBILI_MAX_SEARCH_PAGES=5
# AUDIOSPIDER_BILIBILI_MAX_VIDEOS_PER_KEYWORD=100
# AUDIOSPIDER_BILIBILI_MAX_PAGES_PER_VIDEO=1
# AUDIOSPIDER_BILIBILI_MAX_NEW_RECORDS=100
# AUDIOSPIDER_BILIBILI_MIN_DURATION_SECONDS=1500
# AUDIOSPIDER_BILIBILI_MAX_DURATION_SECONDS=14400
